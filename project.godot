; Engine configuration file.
config_version=5

[application]

config/name="Explosion VFX — Lite"
config/description="Free fireball-explosion effect for Godot 4."
run/main_scene="res://demo/dragdrop_example.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/explosion_vfx_lite/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
